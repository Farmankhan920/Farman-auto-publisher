# Copy these into Vercel > Project > Settings > Environment Variables.
# Never commit real values to GitHub.

# --- Required for TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://auto-three-cyan.vercel.app/api/tiktok/callback

# --- Required for Google Drive ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional (defaults to <your domain>/api/google/callback)
GOOGLE_REDIRECT_URI=https://auto-three-cyan.vercel.app/api/google/callback

# --- Server-side storage (recommended; needed for scheduling) ---
# Added automatically when you connect Upstash Redis / Vercel KV from the Vercel Storage tab:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN are also supported)

# --- Scheduling ---
# Any long random string. Vercel Cron and your own triggers send it as "Authorization: Bearer <value>".
CRON_SECRET=

# --- Optional ---
# Encryption secret for stored tokens. If empty, a key is derived from TIKTOK_CLIENT_SECRET.
SESSION_SECRET=
